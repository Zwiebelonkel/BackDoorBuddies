[node name="BlenderRoomTemplate" type="Node3D"]
editor_description = "Duplicate this scene for a Blender room. Instance the imported or inherited visual scene below Visuals, then configure collision, bounds, sockets and item spawn points in Godot."
script = ExtResource("1_room")
room_id = &"blender_room"
minimum_generation_depth = 1
minimum_items = 1

[node name="Visuals" type="Node3D" parent="."]
editor_description = "Instance your imported .glb or an inherited visual .tscn here. Keep gameplay nodes outside the imported scene so re-exporting from Blender is safe."

[node name="GameplayCollision" type="StaticBody3D" parent="."]
editor_description = "Replace or extend these simple collisions in Godot. Keep walkable surfaces on physics layer 1 so item spawn rays can find them."
collision_mask = 0

[node name="FloorCollision" type="CollisionShape3D" parent="GameplayCollision"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.05, 0)
shape = SubResource("FloorCollisionShape")

[node name="RoomBounds" type="Area3D" parent="."]
editor_description = "Resize this box to the room footprint. Keep it slightly inside shared wall/socket planes to prevent false overlap rejection."
collision_layer = 0
collision_mask = 0
monitoring = false
monitorable = false

[node name="CollisionShape3D" type="CollisionShape3D" parent="RoomBounds"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
shape = SubResource("RoomBoundsShape")

[node name="DoorSockets" type="Node3D" parent="."]
editor_description = "Place sockets at the centre of each doorway on floor level. A socket's local +Z axis must point out of the room. Delete unused examples."

